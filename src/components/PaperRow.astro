---
import type { CollectionEntry } from 'astro:content';
import Teaser from './Teaser.astro';
import { clean } from '../lib/site';
import { formatAuthors, paperLinks, primaryLink, venueLine } from '../lib/papers';

interface Props {
  paper: CollectionEntry<'papers'>;
  me: string;
  teaser?: boolean;
}

const { paper, me, teaser = false } = Astro.props;
const d = paper.data;
const titleHref = primaryLink(d.links);
const links = paperLinks(d.links);
const tldr = clean(d.tldr);
const bibtex = clean(d.bibtex);
---
<article class:list={['paper', { 'paper--teaser': teaser }]} id={`paper-${paper.id}`}>
  {teaser && <Teaser id={paper.id} title={d.title} />}
  <div class="paper-body">
    <h3 class="paper-title">{titleHref ? <a href={titleHref}>{d.title}</a> : d.title}</h3>
    <p class="paper-meta" set:html={formatAuthors(d.authors, me)}></p>
    <p class="paper-meta">{venueLine(d)}</p>
    {tldr && <p class="paper-tldr">{tldr}</p>}
    {links.length > 0 && (
      <ul class="paper-links">
        {links.map((l) => (
          <li><a href={l.href} aria-label={`${l.label}: ${d.title}`}>{l.label}</a></li>
        ))}
      </ul>
    )}
    {bibtex && (
      <details class="bibtex">
        <summary>BibTeX</summary>
        <pre><code>{bibtex}</code></pre>
      </details>
    )}
  </div>
</article>
