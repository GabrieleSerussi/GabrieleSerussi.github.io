---
import type { CollectionEntry } from 'astro:content';
import { PROFILE_LINKS, clean, lastUpdated, track } from '../lib/site';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
}

const { profile } = Astro.props;
const links = Object.entries(PROFILE_LINKS)
  .map(([key, label]) => ({ label, href: clean(profile.links[key]) }))
  .filter((l): l is { label: string; href: string } => Boolean(l.href));
const updated = lastUpdated();
const day = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<footer class="site-footer">
  <p>{profile.name}. Last updated <time datetime={updated.toISOString().slice(0, 10)}>{day.format(updated)}</time>.{profile.bio && <> <a href="/bio/" data-goatcounter-click={track('footer', 'Bio')}>Bio</a>.</>}</p>
  <ul aria-label="Profiles">
    {links.map((l) => (
      <li><a href={l.href} rel="me" data-goatcounter-click={track('footer', l.label)}>{l.label}</a></li>
    ))}
  </ul>
</footer>
