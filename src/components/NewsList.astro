---
import type { CollectionEntry } from 'astro:content';
import { inlineMd } from '../lib/site';

interface Props {
  items: CollectionEntry<'news'>[];
}

// Items older than 180 days drop off. The weekly scheduled rebuild keeps this honest.
const MAX_AGE_DAYS = 180;
const MAX_ITEMS = 5;
const { items } = Astro.props;
const cutoff = Date.now() - MAX_AGE_DAYS * 24 * 60 * 60 * 1000;
const recent = items
  .map((item) => item.data)
  .filter((n) => n.date.getTime() >= cutoff)
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, MAX_ITEMS);
const month = new Intl.DateTimeFormat('en-GB', { month: 'short', year: 'numeric', timeZone: 'UTC' });
---
{recent.length > 0 && (
  <section class="section" id="news" aria-labelledby="news-title">
    <div class="section-head">
      <h2 id="news-title">News</h2>
    </div>
    <ul class="news">
      {recent.map((n) => (
        <li>
          <time datetime={n.date.toISOString().slice(0, 10)}>{month.format(n.date)}</time>
          <span set:html={inlineMd(n.text)}></span>
        </li>
      ))}
    </ul>
  </section>
)}
