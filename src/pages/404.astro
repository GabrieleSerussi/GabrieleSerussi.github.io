---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';

const name = (await getEntry('profile', 'me'))?.data.name ?? 'Home';
---
<Base title={`Page not found | ${name}`} description="There is no page at this address." noindex>
  <div class="page">
    <header class="subhead"><a class="home-link" href="/">{name}</a></header>
    <main id="main">
      <h1 class="page-title">There's no page at this address</h1>
      <p class="prose notfound">It may have moved when the site was rebuilt. The <a href="/">homepage</a> and the <a href="/publications/">publications list</a> have everything.</p>
    </main>
  </div>
</Base>
